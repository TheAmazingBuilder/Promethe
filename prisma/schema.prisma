// Promethe — Prisma schema for PostgreSQL / Supabase.
// Conventions:
//  - snake_case DB columns via @map, camelCase in TS
//  - Decimal for ALL money / price / lots / pip values (never floats)
//  - Status-like columns are String, validated by Zod at the edge
//  - Lists (timeframes, sessions, checklist results) are JSON-encoded strings
//    for predictable PostgreSQL compatibility.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth & profile
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile          Profile?
  authSessions     AuthSession[]
  accounts         Account[]
  cashTransactions CashTransaction[]
  instruments      Instrument[]
  strategies       Strategy[]
  setups           Setup[]
  playbookRules    PlaybookRule[]
  checklistTemplates ChecklistTemplate[]
  trades           Trade[]
  tags             Tag[]
  screenshots      TradeScreenshot[]
  journalEntries   JournalEntry[]
  tradingRules     TradingRule[]
  goals            Goal[]
  savedViews       SavedView[]

  // ── v2 ──
  templates               TradeTemplate[]
  pushSubscriptions       PushSubscription[]
  reminderSettings        ReminderSetting[]
  notificationLogs        NotificationLog[]
  offlineSyncLogs         OfflineSyncLog[]
  tradeReviews            TradeReview[]
  reviewQuestionTemplates ReviewQuestionTemplate[]
  reports                 Report[]
  reportSetting           ReportSetting?
  scenarios               Scenario[]
  monteCarloRuns          MonteCarloRun[]
  economicEvents          EconomicEvent[]
  eventWatchlist          EventWatchlist?
  marketContextSnapshots  MarketContextSnapshot[]
  propFirmRuleSets        PropFirmRuleSet[]
  propChallenges          PropChallenge[]
  propPayouts             PropPayout[]
  propExpenses            PropExpense[]

  // ── v3 ──
  brokerConnections        BrokerConnection[]
  syncEventLogs            SyncEventLog[]
  symbolMappings           SymbolMapping[]
  magicNumberMappings      MagicNumberMapping[]
  tradeModifications       TradeModification[]
  equitySnapshots          AccountEquitySnapshot[]
  importBatches            ImportBatch[]
  reconciliationCandidates ReconciliationCandidate[]
  tradeMergeLogs           TradeMergeLog[]
  shareLinks               ShareLink[]
  mentorInvitationsSent    MentorInvitation[]        @relation("InvitationOwner")
  mentorAccessesGranted    MentorAccess[]            @relation("MentorAccessOwner")
  mentorAccessesReceived   MentorAccess[]            @relation("MentorAccessMentor")
  tradeCommentsAuthored    TradeComment[]            @relation("CommentAuthor")
  consentRecords           ConsentRecord[]
  accountDeletionRequest   AccountDeletionRequest?
  dataExportLogs           DataExportLog[]

  // ── v2.5 Module 1 — customizable dashboards ──
  dashboards             Dashboard[]
  customMetrics          CustomMetric[]
  dashboardTemplates     UserDashboardTemplate[]
  appearance             UserAppearance?

  // ── v2.5 Module 2 — advanced charts ──
  savedCharts        SavedChart[]
  chartAnnotations   ChartAnnotation[]
  benchmarkProfiles  BenchmarkProfile[]

  // ── v2.5 Module 4 — productivity & ergonomics ──
  keyboardShortcuts     KeyboardShortcut[]
  tableColumnPrefs      TableColumnPreference[]
  customFieldDefs       CustomFieldDefinition[]
  changeLogs            ChangeLog[]
  batchEntryDrafts      BatchEntryDraft[]

  // ── v2.5 Module 5 — trading tools ──
  toolScenarios        ToolScenario[]
  fxRates              FxRate[]
  marketSessionSettings MarketSessionSetting[]
  exitPlans            ExitPlan[]
  exposureAlertSetting ExposureAlertSetting?

  // ── v2.5 Module 8 — privacy, accessibility & time zones ──
  displayPreference     UserDisplayPreference?

  // ── Gaïa — workspace de notes ──
  gaiaNotes     Note[]
  gaiaFolders   NoteFolder[]
  gaiaTags      NoteTag[]
  gaiaTemplates NoteTemplate[]
  gaiaVersions  NoteVersion[]

  // ── v2.5 Module 6 — advanced analytics ──
  lifecycleStats      TradeLifecycleStats[]
  traderScoreSnapshots TraderScoreSnapshot[]
  tradeAnomalies      TradeAnomaly[]
  weeklyPlanActions   WeeklyPlanAction[]

  // ── v2.5 Module 9 — Discord / Telegram integrations ──
  integrationEndpoints     IntegrationEndpoint[]
  integrationSubscriptions IntegrationSubscription[]
  outboundMessages         OutboundMessage[]

  @@map("users")
}

/// Server-side session store; id is a versioned SHA-256 digest of the opaque cookie token.
model AuthSession {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// Created automatically on signup. id === users.id
model Profile {
  id                String   @id
  displayName       String   @map("display_name")
  timezone          String   @default("UTC")
  baseCurrency      String   @default("USD") @map("base_currency")
  locale            String   @default("en") // 'en' — UI language, English only (addendum §11.6)
  theme             String   @default("system")
  defaultAccountId  String?  @map("default_account_id")
  /// v2 — quick-entry smart defaults (JSON): lastAccountId, lastInstrumentId,
  /// lastTimeframe, rememberedLots {symbol: lots}, favoriteInstrumentIds []
  preferencesJson   String   @default("{}") @map("preferences_json")
  /// v3 — mentoring/mention handle: unique, lowercase, [a-z0-9_], 3-24 chars.
  /// Required before inviting mentors or being mentioned.
  handle            String?  @unique
  /// v3 — name shown to mentors/share viewers (falls back to displayName)
  publicDisplayName String?  @map("public_display_name")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Accounts & cash flows
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                      String    @id @default(cuid())
  userId                  String    @map("user_id")
  name                    String
  broker                  String?
  type                    String    @default("LIVE") // LIVE | DEMO | PROP | BACKTEST
  currency                String    @default("USD")
  initialBalance          Decimal   @default(0) @map("initial_balance")
  leverage                Int?
  /// v2.5 Module 5 — margin simulator defaults (null = 100 / 50).
  marginCallLevel         Decimal? @map("margin_call_level")
  stopOutLevel            Decimal? @map("stop_out_level")
  isActive                Boolean   @default(true) @map("is_active")
  // ── PROP firm challenge fields (addendum §11.5) ──
  maxDailyLossPercent     Decimal?  @map("max_daily_loss_percent")
  maxTotalDrawdownPercent Decimal?  @map("max_total_drawdown_percent")
  profitTarget            Decimal?  @map("profit_target")
  drawdownType            String?   @map("drawdown_type") // STATIC | TRAILING
  startDate               DateTime? @map("start_date")
  createdAt               DateTime  @default(now()) @map("created_at")

  // ── v3 ── broker identity (bound by the first EA heartbeat, also used to
  // match imported history files)
  brokerServer String? @map("broker_server")
  brokerLogin  String? @map("broker_login")

  // ── v2.5 Module 8 — broker server time description ──
  /// IANA | FIXED_OFFSET | NY_CLOSE (MT4/MT5 "New York close" convention:
  /// GMT+2 in winter, GMT+3 in summer, following US DST).
  serverTimezoneMode       String  @default("IANA") @map("server_timezone_mode")
  /// IANA zone when serverTimezoneMode = IANA.
  serverTimezone           String? @map("server_timezone")
  /// Fixed UTC offset in minutes when serverTimezoneMode = FIXED_OFFSET.
  serverFixedOffsetMinutes Int?    @map("server_fixed_offset_minutes")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades           Trade[]
  cashTransactions CashTransaction[]
  propChallenges   PropChallenge[]

  // ── v3 ──
  brokerConnections        BrokerConnection[]
  equitySnapshots          AccountEquitySnapshot[]
  importBatches            ImportBatch[]
  reconciliationCandidates ReconciliationCandidate[]
  weeklyPlanActions        WeeklyPlanAction[]

  @@index([userId])
  @@map("accounts")
}

/// Deposits/withdrawals so the equity curve never counts cash flows as performance.
model CashTransaction {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  accountId String   @map("account_id")
  type      String // DEPOSIT | WITHDRAWAL | BONUS | ADJUSTMENT
  amount    Decimal // signed: + deposit/bonus, - withdrawal
  date      DateTime
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── v3 ── deposit/withdrawal dedupe on broker backfill/import
  externalId String? @map("external_id")

  @@unique([accountId, externalId])
  @@index([userId])
  @@index([userId, date])
  @@index([accountId, date])
  @@map("cash_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Instruments (userId = null → global preset, seeded)
// ─────────────────────────────────────────────────────────────────────────────

model Instrument {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  symbol        String
  name          String
  assetClass    String   @map("asset_class") // FOREX | METAL | INDEX | CRYPTO | STOCK | COMMODITY | FUTURES
  baseCurrency  String?  @map("base_currency")
  quoteCurrency String   @default("USD") @map("quote_currency")
  digits        Int      @default(5)
  pipSize       Decimal  @default(0.0001) @map("pip_size")
  pointSize     Decimal  @default(0.00001) @map("point_size")
  contractSize  Decimal  @default(100000) @map("contract_size")
  tickSize      Decimal? @map("tick_size")
  tickValue     Decimal? @map("tick_value")
  /// v2.5 Module 8 — market timezone (IANA) for market-time display
  /// (null = asset-class default: indices/stocks → exchange zone, else UTC).
  marketTimezone String? @map("market_timezone")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  user                   User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades                 Trade[]
  candles                PriceCandle[]
  marketContextSnapshots MarketContextSnapshot[]
  templates              TradeTemplate[]

  @@unique([userId, symbol])
  @@index([userId])
  @@map("instruments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Strategies
// ─────────────────────────────────────────────────────────────────────────────

model Strategy {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  name               String
  description        String?
  color              String   @default("#10b981")
  status             String   @default("ACTIVE") // ACTIVE | TESTING | DRAFT | PAUSED | ARCHIVED
  timeframesJson     String?  @map("timeframes_json") // JSON string[]
  instrumentsJson    String?  @map("instruments_json") // JSON string[] (symbols)
  sessionsJson       String?  @map("sessions_json") // JSON string[]
  entryRules         String?  @map("entry_rules") // markdown
  exitRules          String?  @map("exit_rules") // markdown
  riskRules          String?  @map("risk_rules") // markdown
  defaultRiskPercent Decimal? @map("default_risk_percent")
  targetRR           Decimal? @map("target_rr")
  // ── Playbook (Phase 2) — definition revision counter, bumped by the
  // server whenever a PATCH touches one of the 13 definition fields
  // (Euforia §17); presentation fields (name, status, grade, color, tags)
  // mutate in place. Trades freeze this value at entry (Trade.strategyVersion).
  version             Int      @default(1)
  grade               String? // A+ | A | B | C (presentation, no version bump)
  detailedDescription String?  @map("detailed_description") // markdown, ≤ 8000
  tagsJson            String?  @map("tags_json") // JSON string[] (presentation)
  marketProfileJson   String?  @map("market_profile_json") // JSON PlaybookMarketProfile
  marketConditionsJson String? @map("market_conditions_json") // JSON MarketCondition[]
  entryConditionsJson String?  @map("entry_conditions_json") // JSON PlaybookEntryCondition[] (AND, group = OR)
  confirmationsJson   String?  @map("confirmations_json") // JSON PlaybookConfirmation[]
  invalidationsJson   String?  @map("invalidations_json") // JSON string[]
  riskJson             String? @map("risk_json") // JSON PlaybookRisk
  tradeManagementJson String?  @map("trade_management_json") // JSON PlaybookManagementRule[]
  exitPlanJson        String?  @map("exit_plan_json") // JSON PlaybookExitRule[]
  // ── v2.5 Module 4 — soft delete (trash) + global search ──
  deletedAt  DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") // userId snapshot (no FK — metadata only)
  searchText String?   @map("search_text") // accent-folded lowercase concat (name, description, rules)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades         Trade[]
  checklistItems StrategyChecklistItem[]
  versions       StrategyVersion[]
  templates      TradeTemplate[]
  setups         Setup[]
  playbookRules  PlaybookRule[]
  checklistTemplates ChecklistTemplate[]

  @@index([userId])
  @@map("strategies")
}

/// Playbook setup (Phase 2) — one named way to trade a strategy. The
/// invalidation is mandatory: it states when the setup is no longer valid.
/// Trades point at a setup (Trade.setupId, SetNull on delete).
model Setup {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  strategyId       String   @map("strategy_id")
  name             String
  description      String?
  status           String   @default("ACTIVE") // ACTIVE | TESTING | DRAFT | PAUSED | ARCHIVED
  context          String? // markdown — when this setup applies
  marketCondition  String?  @map("market_condition") // TRENDING | RANGING | HIGH_VOLATILITY | LOW_VOLATILITY | EXPANSION | COMPRESSION | BULLISH_STRUCTURE | BEARISH_STRUCTURE | NEUTRAL_STRUCTURE
  trigger          String?
  confirmation     String?
  entryModel       String?  @map("entry_model")
  stopModel        String?  @map("stop_model")
  targetModel      String?  @map("target_model")
  /// When the setup is no longer valid — critical, never optional.
  invalidation     String
  notes            String? // markdown
  tagsJson         String?  @map("tags_json") // JSON string[]
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  trades   Trade[]

  @@index([userId])
  @@index([strategyId])
  @@map("setups")
}

/// Playbook operating rule (Phase 2, Euforia §24) — a written rule of the
/// playbook, global or scoped to one strategy. `evaluatable` is declarative:
/// true when the rule could be checked against market data or the calendar.
model PlaybookRule {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  title          String
  detail         String   @default("")
  category       String // RISK | SESSION | NEWS | BEHAVIOR | EXECUTION | CUSTOM
  scope          String   @default("GLOBAL") // GLOBAL | STRATEGY
  strategyId     String?  @map("strategy_id")
  evaluatable    Boolean  @default(false)
  evaluationHint String?  @map("evaluation_hint")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([strategyId])
  @@map("playbook_rules")
}

/// Playbook checklist template (Phase 2, Euforia §16) — a reusable
/// pre-trade checklist. strategyId null = global, usable with any strategy.
model ChecklistTemplate {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  strategyId String?  @map("strategy_id")
  name       String
  itemsJson  String   @map("items_json") // JSON: [{ label, required, category? }] (max 24)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([strategyId])
  @@map("checklist_templates")
}

model StrategyChecklistItem {
  id         String  @id @default(cuid())
  strategyId String  @map("strategy_id")
  label      String
  category   String  @default("ENTRY") // ENTRY | EXIT | RISK | CONTEXT
  order      Int     @default(0)
  isRequired Boolean @default(true) @map("is_required")

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId])
  @@map("strategy_checklist_items")
}

/// Immutable snapshot of a strategy at version N (addendum §11.3).
/// Snapshots are JSON strings, never mutated after creation.
/// origin MANUAL = saved by hand from the versions dialog; AUTO = frozen by
/// the server before a definition edit (Euforia §17). AUTO snapshots are
/// never deletable.
model StrategyVersion {
  id         String   @id @default(cuid())
  strategyId String   @map("strategy_id")
  version    Int
  snapshot   String // JSON: full strategy + checklist at save time
  note       String?
  origin     String   @default("MANUAL") // MANUAL | AUTO
  createdAt  DateTime @default(now()) @map("created_at")

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, version])
  @@index([strategyId, version])
  @@map("strategy_versions")
}

/// Named filter presets per page (addendum §11.3) — e.g. "XAUUSD wins this month".
model SavedView {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  /// v1 page key kept for back-compat ('trades' | 'analytics' | …) — the
  /// Module 4 entity discriminator is authoritative when present.
  page        String // 'trades' | 'analytics' | …
  name        String
  filtersJson String   @map("filters_json") // JSON: serialized filter state
  // ── v2.5 Module 4 — advanced saved views (§4.3) ──
  /// TRADES | JOURNAL | STRATEGIES | REPORTS | CASH | NEWS | … (nullable for
  /// legacy rows; derived from `page` on read).
  entity       String?
  columnsJson  String?  @map("columns_json") // JSON: visible columns + order
  sortJson     String?  @map("sort_json") // JSON: [{ id, desc }]
  groupingJson String?  @map("grouping_json") // JSON: grouping state
  isPinned     Boolean  @default(false) @map("is_pinned")
  isDefault    Boolean  @default(false) @map("is_default")
  order        Int      @default(0)
  /// Schema version of columnsJson/sortJson/groupingJson — stale fields fall
  /// back gracefully on read (missing keys → defaults).
  version      Int      @default(2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, page, name])
  @@index([userId, page])
  @@index([userId, entity])
  @@map("saved_views")
}

// ─────────────────────────────────────────────────────────────────────────────
// Trades (core)
// ─────────────────────────────────────────────────────────────────────────────

model Trade {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  accountId    String  @map("account_id")
  strategyId   String? @map("strategy_id")
  instrumentId String  @map("instrument_id")
  externalId   String? @map("external_id") // broker ticket — import dedupe

  // Setup
  direction       String // LONG | SHORT
  orderType       String  @default("MARKET") @map("order_type") // MARKET | LIMIT | STOP | STOP_LIMIT
  status          String  @default("OPEN") // OPEN | CLOSED | PENDING | CANCELLED
  timeframe       String?
  session         String? // ASIAN | LONDON | NEW_YORK | OVERLAP | OTHER (from entry time UTC)
  setupType       String? @map("setup_type")
  /// Playbook setup used (nullable; free-text setupType kept for back-compat).
  setupId         String? @map("setup_id")
  /// Strategy definition version frozen at entry (Strategy.version).
  strategyVersion Int?    @map("strategy_version")
  marketCondition String? @map("market_condition") // TRENDING | RANGING | VOLATILE | NEWS | OTHER

  // Entry / exit (stored UTC, displayed in user timezone)
  entryTime         DateTime  @map("entry_time")
  exitTime          DateTime? @map("exit_time")
  entryPrice        Decimal   @map("entry_price")
  exitPrice         Decimal?  @map("exit_price")
  stopLoss          Decimal?  @map("stop_loss")
  takeProfit        Decimal?  @map("take_profit")
  initialStopLoss   Decimal?  @map("initial_stop_loss")
  initialTakeProfit Decimal?  @map("initial_take_profit")
  mfePrice          Decimal?  @map("mfe_price") // max favorable excursion (price extreme)
  maePrice          Decimal?  @map("mae_price") // max adverse excursion (price extreme)
  /// v2.5 Module 5 — current price override, edited in the exposure dashboard.
  currentPrice      Decimal?  @map("current_price")

  // Size & risk
  lots                  Decimal  @default(0)
  units                 Decimal? // = lots * contractSize
  riskAmount            Decimal? @map("risk_amount")
  riskPercent           Decimal? @map("risk_percent")
  accountBalanceAtEntry Decimal? @map("account_balance_at_entry")

  // Results
  pips        Decimal?
  points      Decimal?
  grossPnl    Decimal? @map("gross_pnl")
  commission  Decimal  @default(0) // signed cost: positive = cost, negative = credit
  swap        Decimal  @default(0) // signed cost
  fees        Decimal  @default(0) // signed cost
  netPnl      Decimal? @map("net_pnl")
  pnlCurrency String   @default("USD") @map("pnl_currency")
  rMultiple   Decimal? @map("r_multiple")
  plannedRR   Decimal? @map("planned_rr")
  realizedRR  Decimal? @map("realized_rr")
  resultType  String?  @map("result_type") // WIN | LOSS | BREAKEVEN
  pnlSource   String   @default("CALCULATED") @map("pnl_source") // CALCULATED | MANUAL
  exitReason  String?  @map("exit_reason") // TP_HIT | SL_HIT | MANUAL | TRAILING | TIME | BREAKEVEN_STOP | PARTIAL | OTHER

  // Psychology & quality
  emotionBefore      String?  @map("emotion_before")
  emotionDuring      String?  @map("emotion_during")
  emotionAfter       String?  @map("emotion_after")
  confidence         Int? // 1-5
  setupQualityRating Int?     @map("setup_quality_rating") // 1-5
  executionRating    Int?     @map("execution_rating") // 1-5
  followedPlan       Boolean? @map("followed_plan")
  /// MRT setup grade (wave 3): A+ | A | B | C, null = ungraded. Distinct
  /// from TradeReview 1-5 scores and from Strategy.grade (strategy
  /// presentation grade) — this is the grade of this trade's setup.
  grade              String? // A+ | A | B | C
  lessonLearned      String?  @map("lesson_learned")

  // Review workflow (addendum §11.3)
  reviewStatus String  @default("NOT_REVIEWED") @map("review_status") // NOT_REVIEWED | REVIEWED
  isDraft      Boolean @default(false) @map("is_draft") // autosaved drafts persist as Trade rows

  // v2 — offline idempotency: dedupe key for the sync engine (4.2)
  clientMutationId   String?  @unique @map("client_mutation_id")
  /// v2 — planned risk (strategy/template) vs actual riskPercent (4.9)
  plannedRiskPercent Decimal? @map("planned_risk_percent")

  // ── v3 — broker sync / import provenance (schema §3.1) ──
  /// MANUAL | EA_SYNC | FILE_IMPORT
  source         String  @default("MANUAL")
  /// Broker position identifier (MT5 positionId / stitched MT4 chain head)
  positionId     String? @map("position_id")
  /// EA magic number (strategy auto-tagging via MagicNumberMapping)
  magicNumber    String? @map("magic_number")
  /// Raw broker comment on the order/position
  brokerComment  String? @map("broker_comment")
  /// Synced/imported trade still missing strategy/notes → review queue
  needsDetails   Boolean @default(false) @map("needs_details")
  /// NONE | MANUAL | EA_TRACKED — where MFE/MAE extremes come from
  mfeMaeSource   String  @default("NONE") @map("mfe_mae_source")
  /// True when the EA tracked the position for its whole lifetime
  mfeMaeComplete Boolean @default(false) @map("mfe_mae_complete")

  // Notes (markdown)
  preTradeAnalysis String  @map("pre_trade_analysis")
  postTradeReview  String  @map("post_trade_review")
  notes            String?

  // Links
  tradingViewUrl   String? @map("trading_view_url")
  checklistResults String? @map("checklist_results") // JSON: { [itemId]: boolean }

  // ── v2.5 Module 4 — productivity ──
  /// Soft delete (trash, 30-day retention). Excluded from all default reads
  /// by the Prisma client extension (src/lib/trash/extension.ts).
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by") // userId snapshot (no FK — metadata only)
  /// JSON { [fieldKey]: value } — validated against CustomFieldDefinition
  /// by a dynamic Zod schema on every write (Module 4 §4.7).
  customFields String?  @map("custom_fields")
  /// Accent-folded lowercase concat of searchable text fields, maintained on
  /// every write — the application-maintained equivalent of a tsvector column
  /// (Postgres upgrade path: pg_trgm GIN index, documented in README).
  searchText  String?  @map("search_text")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategy       Strategy?            @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  setup          Setup?               @relation(fields: [setupId], references: [id], onDelete: SetNull)
  instrument     Instrument           @relation(fields: [instrumentId], references: [id])
  executions     TradeExecution[]
  tags           TradeTag[]
  screenshots    TradeScreenshot[]
  ruleViolations TradeRuleViolation[]
  lifecycleStats TradeLifecycleStats?
  anomalies      TradeAnomaly[]

  // ── v2 ──
  review        TradeReview?
  eventLinks    TradeEventLink[]
  marketContext MarketContextSnapshot?

  // ── v3 ──
  modifications TradeModification[]

  // ── v2.5 Module 5 — partial exit plan (nullable, plan deleted -> SetNull).
  exitPlanId String? @map("exit_plan_id")
  exitPlan   ExitPlan? @relation(fields: [exitPlanId], references: [id], onDelete: SetNull)

  @@unique([accountId, externalId])
  @@index([accountId, positionId])
  @@index([userId, entryTime])
  @@index([userId, strategyId])
  @@index([userId, setupId])
  @@index([userId, instrumentId])
  @@index([userId, status])
  @@index([userId, isDraft])
  @@index([userId, reviewStatus])
  @@index([userId, grade])
  @@index([userId, deletedAt])
  @@index([accountId])
  @@map("trades")
}

/// Partial closes & scale-ins. When present, Trade aggregates derive from these.
model TradeExecution {
  id         String   @id @default(cuid())
  tradeId    String   @map("trade_id")
  type       String // ENTRY | ADD | PARTIAL_EXIT | FINAL_EXIT
  time       DateTime
  price      Decimal
  lots       Decimal
  commission Decimal  @default(0) // signed cost
  pnl        Decimal? // realized on exits (quote currency, before costs)
  createdAt  DateTime @default(now()) @map("created_at")

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@map("trade_executions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tags (userId = null → global preset e.g. default mistake tags)
// ─────────────────────────────────────────────────────────────────────────────

model Tag {
  id     String     @id @default(cuid())
  userId String?    @map("user_id")
  name   String
  color  String     @default("#64748b")
  kind   String     @default("CUSTOM") // SETUP | MISTAKE | CONTEXT | CUSTOM
  // ── v2.5 Module 4 — soft delete (trash) ──
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  trades   TradeTag[]

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model TradeTag {
  tradeId String @map("trade_id")
  tagId   String @map("tag_id")

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@index([tagId])
  @@map("trade_tags")
}

// ─────────────────────────────────────────────────────────────────────────────
// Screenshots (local storage in sandbox: /uploads/{userId}/...)
// ─────────────────────────────────────────────────────────────────────────────

model TradeScreenshot {
  id          String   @id @default(cuid())
  tradeId     String   @map("trade_id")
  userId      String   @map("user_id")
  storagePath String   @map("storage_path")
  label       String? // BEFORE | ENTRY | EXIT | AFTER
  caption     String?
  createdAt   DateTime @default(now()) @map("created_at")

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([userId])
  @@map("trade_screenshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Journal & rules
// ─────────────────────────────────────────────────────────────────────────────

/// Daily journal. date = YYYY-MM-DD in the USER's timezone (avoids UTC drift).
model JournalEntry {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  date             String
  preMarketPlan    String?  @map("pre_market_plan") // markdown
  postMarketReview String?  @map("post_market_review") // markdown
  mood             Int? // 1-5
  sleepQuality     Int?     @map("sleep_quality") // 1-5
  disciplineScore  Int?     @map("discipline_score") // 1-5
  keyLesson        String?  @map("key_lesson")
  marketBias       String?  @map("market_bias")
  // ── v2.5 Module 4 — soft delete (trash) + global search ──
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  searchText String?   @map("search_text") // folded concat (date, plan, review, lesson, bias)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("journal_entries")
}

/// Personal trading rules (max trades/day, max daily loss, …) — phase 6 violation detection.
model TradingRule {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  kind        String // MAX_TRADES_PER_DAY | MAX_DAILY_LOSS | MAX_RISK_PER_TRADE | MIN_PLANNED_RR | CUSTOM
  value       Decimal
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  violations TradeRuleViolation[]

  @@index([userId])
  @@map("trading_rules")
}

/// Measurable goal with dashboard progress (addendum §11.4 — ships in phase 6).
model Goal {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  name        String
  description String?
  metric      String // NET_PNL | WIN_RATE | AVG_R | PROFIT_FACTOR | TRADE_COUNT | DISCIPLINE_SCORE
  targetValue Decimal   @map("target_value")
  period      String // WEEKLY | MONTHLY | QUARTERLY | YEARLY | ALL_TIME
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  status      String    @default("ACTIVE") // ACTIVE | ACHIEVED | MISSED | PAUSED
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("goals")
}

/// Rule violation attached to a trade (addendum §11.4) — written by the
/// violation detector (phase 6), read by the trade detail and dashboards.
model TradeRuleViolation {
  tradeId   String   @map("trade_id")
  ruleId    String   @map("rule_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  trade Trade       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  rule  TradingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([tradeId, ruleId])
  @@index([ruleId])
  @@map("trade_rule_violations")
}

// ═════════════════════════════════════════════════════════════════════════════
// v2 — Productivity, advanced analytics, market context & prop firm toolkit
// (all models created up-front; feature phases ship incrementally)
// ═════════════════════════════════════════════════════════════════════════════

// ── 4.1 Quick trade entry: templates ────────────────────────────────────────

/// Reusable prefill for the quick/full trade form (v2 §4.1).
model TradeTemplate {
  id                      String    @id @default(cuid())
  userId                  String    @map("user_id")
  strategyId              String?   @map("strategy_id")
  instrumentId            String?   @map("instrument_id")
  name                    String
  direction               String? // LONG | SHORT
  timeframe               String?
  session                 String? // ASIAN | LONDON | NEW_YORK | OVERLAP | OTHER
  orderType               String?   @map("order_type") // MARKET | LIMIT | STOP | STOP_LIMIT
  defaultRiskPercent      Decimal?  @map("default_risk_percent")
  defaultRiskAmount       Decimal?  @map("default_risk_amount")
  defaultLots             Decimal?  @map("default_lots")
  defaultStopLossPips     Decimal?  @map("default_stop_loss_pips")
  defaultTakeProfitPips   Decimal?  @map("default_take_profit_pips")
  /// JSON string[] of tag ids
  defaultTagIds           String?   @map("default_tag_ids")
  /// JSON string[] of strategy checklist item ids
  defaultChecklistItemIds String?   @map("default_checklist_item_ids")
  prefilledNotes          String?   @map("prefilled_notes") // markdown
  usageCount              Int       @default(0) @map("usage_count")
  lastUsedAt              DateTime? @map("last_used_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy   Strategy?   @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  instrument Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, usageCount])
  @@map("trade_templates")
}

// ── 4.3 Reminders & web push ────────────────────────────────────────────────

/// Per-device Web Push subscription (VAPID). Endpoint unique — one row per device.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Per-type reminder settings, evaluated in the USER's timezone (v2 §4.3).
model ReminderSetting {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  /// EVENING_JOURNAL | UNREVIEWED_TRADES | WEEKLY_REPORT_READY | MONTHLY_REPORT_READY | PROP_DRAWDOWN_ALERT | NEWS_UPCOMING
  type            String
  enabled         Boolean   @default(true)
  /// PUSH | EMAIL | BOTH
  channel         String    @default("BOTH")
  /// HH:mm local
  localTime       String    @default("20:00")
  /// JSON int[] (0=Sunday … 6=Saturday)
  daysOfWeek      String    @default("[1,2,3,4,5]") @map("days_of_week")
  timezone        String    @default("UTC")
  quietHoursStart String?   @map("quiet_hours_start") // HH:mm
  quietHoursEnd   String?   @map("quiet_hours_end") // HH:mm
  lastSentAt      DateTime? @map("last_sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("reminder_settings")
}

/// Every notification attempt (push/email) — powers the in-app center + dedupe.
model NotificationLog {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  channel   String // PUSH | EMAIL | IN_APP
  title     String
  body      String
  url       String?
  sentAt    DateTime  @default(now()) @map("sent_at")
  readAt    DateTime? @map("read_at")
  /// SENT | FAILED | SKIPPED
  status    String    @default("SENT")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([userId, readAt])
  @@map("notification_logs")
}

/// Offline sync audit trail (optional debugging, v2 §4.2).
model OfflineSyncLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  clientId  String?  @map("client_id")
  operation String
  /// OK | CONFLICT | FAILED | DUPLICATE
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("offline_sync_logs")
}

// ── 4.4 Guided trade review ─────────────────────────────────────────────────

/// Structured post-trade review — one per trade. A row may also hold only a Playbook match; reviewStatus tracks completion of the structured workflow.
model TradeReview {
  id                    String   @id @default(cuid())
  tradeId               String   @unique @map("trade_id")
  userId                String   @map("user_id")
  /// Playbook match, declared at review time only — never derived from
  /// followedPlan (Euforia §20). MATCHED | PARTIAL | OFF_PLAYBOOK.
  playbookMatch         String?  @map("playbook_match")
  /// Score fields are nullable: a review may exist only to declare the
  /// playbook match, without scored answers (no invented scores).
  followedPlan          Boolean?
  /// 1-5
  planAdherenceScore    Int?     @map("plan_adherence_score")
  executionQuality      Int?     @map("execution_quality")
  entryQuality          Int?     @map("entry_quality")
  exitQuality           Int?     @map("exit_quality")
  riskManagementScore   Int?     @map("risk_management_score")
  emotionalControlScore Int?     @map("emotional_control_score")
  /// YES | NO | MAYBE
  wouldTakeAgain        String?  @map("would_take_again")
  mainLesson            String?  @map("main_lesson")
  whatWentWell          String?  @map("what_went_well")
  whatToImprove         String?  @map("what_to_improve")
  /// JSON string[] of tag ids (mistake tags)
  mistakeTagIds         String?  @map("mistake_tag_ids")
  /// JSON snapshots of custom review answers.
  customAnswers         String?  @map("custom_answers")
  reviewedAt            DateTime @default(now()) @map("reviewed_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@map("trade_reviews")
}

/// Optional custom review questions (v2 §4.4).
model ReviewQuestionTemplate {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  question  String
  /// SCALE | BOOLEAN | TEXT
  type      String   @default("SCALE")
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("review_question_templates")
}

// ── 4.5 Automatic reports ───────────────────────────────────────────────────

/// Generated weekly/monthly/custom report — snapshots keep history stable.
model Report {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  /// WEEKLY | MONTHLY | CUSTOM
  type             String
  periodStart      DateTime  @map("period_start")
  periodEnd        DateTime  @map("period_end")
  accountId        String?   @map("account_id") // null = all accounts
  statsSnapshot    String    @map("stats_snapshot") // JSON
  insightsSnapshot String    @map("insights_snapshot") // JSON
  pdfStoragePath   String?   @map("pdf_storage_path")
  emailedAt        DateTime? @map("emailed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, periodStart, periodEnd])
  @@index([userId, periodStart])
  @@map("reports")
}

/// Per-user report preferences (v2 §4.5).
model ReportSetting {
  id                 String  @id @default(cuid())
  userId             String  @unique @map("user_id")
  weeklyEnabled      Boolean @default(true) @map("weekly_enabled")
  monthlyEnabled     Boolean @default(true) @map("monthly_enabled")
  /// 0=Sunday … 6=Saturday
  weeklyDayOfWeek    Int     @default(1) @map("weekly_day_of_week")
  emailEnabled       Boolean @default(false) @map("email_enabled")
  emailAddress       String? @map("email_address")
  includeScreenshots Boolean @default(false) @map("include_screenshots")
  /// en (English only)
  language           String  @default("en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("report_settings")
}

// ── 4.7 / 4.8 Saved simulations ─────────────────────────────────────────────

/// Saved "what-if" scenario (v2 §4.7).
model Scenario {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  /// SKIP_SEGMENT | CUSTOM_SL | FIXED_RISK | FIXED_RR | CUSTOM_FILTER | MAX_TRADES_PER_DAY | MAX_DAILY_LOSS
  type       String
  paramsJson String   @map("params_json")
  resultJson String   @map("result_json")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("scenarios")
}

/// Saved Monte Carlo run — reproducible via the stored seed (v2 §4.8).
model MonteCarloRun {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  paramsJson String   @map("params_json") // iterations, sampling, risk model, ruin threshold, seed…
  resultJson String   @map("result_json") // percentiles, ruin probability, drawdown distribution…
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("monte_carlo_runs")
}

// ── 4.10 Economic calendar & news impact ────────────────────────────────────

/// Economic event. userId = null → shared/global row (e.g. provider sync).
model EconomicEvent {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  /// MANUAL | CSV | PROVIDER
  source      String   @default("MANUAL")
  externalId  String?  @map("external_id")
  title       String
  currency    String // USD | EUR | GBP | …
  country     String?
  /// LOW | MEDIUM | HIGH
  impact      String
  /// NFP | CPI | FOMC | PPI | GDP | PMI | RETAIL_SALES | RATE_DECISION | SPEECH | OTHER
  category    String
  scheduledAt DateTime @map("scheduled_at") // UTC
  actual      String?
  forecast    String?
  previous    String?
  unit        String?
  createdAt   DateTime @default(now()) @map("created_at")

  user  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  links TradeEventLink[]

  @@unique([source, externalId])
  @@index([scheduledAt])
  @@index([userId])
  @@map("economic_events")
}

/// Trade ↔ event link with phase classification (v2 §4.10).
model TradeEventLink {
  id            String   @id @default(cuid())
  tradeId       String   @map("trade_id")
  eventId       String   @map("event_id")
  /// trade entry − event time, in minutes (signed)
  offsetMinutes Int      @map("offset_minutes")
  /// BEFORE | DURING | AFTER (configurable windows, defaults: −60 / ±5 / +120)
  phase         String
  autoLinked    Boolean  @default(true) @map("auto_linked")
  createdAt     DateTime @default(now()) @map("created_at")

  trade Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  event EconomicEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([tradeId, eventId])
  @@index([eventId])
  @@map("trade_event_links")
}

/// Per-user news preferences: which currencies/categories/impacts matter (v2 §4.10).
model EventWatchlist {
  id         String   @id @default(cuid())
  userId     String   @unique @map("user_id")
  /// JSON string[] of currency codes
  currencies String   @default("[\"USD\"]")
  /// JSON string[] of categories (empty = all)
  categories String   @default("[]")
  /// LOW | MEDIUM | HIGH — minimum impact shown
  minImpact  String   @default("MEDIUM") @map("min_impact")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("event_watchlists")
}

// ── 4.11 Volatility & market regime context ─────────────────────────────────

/// ATR/regime snapshot at the trade's entry (v2 §4.11).
model MarketContextSnapshot {
  id               String   @id @default(cuid())
  tradeId          String   @unique @map("trade_id")
  userId           String   @map("user_id")
  instrumentId     String   @map("instrument_id")
  timeframe        String
  atr14Value       Decimal  @map("atr14_value")
  atr14Pips        Decimal  @map("atr14_pips")
  /// 0-100 vs the last N periods (null when not enough history)
  atrPercentile    Decimal? @map("atr_percentile")
  dailyRangePips   Decimal? @map("daily_range_pips")
  /// LOW | NORMAL | HIGH | EXTREME
  volatilityRegime String   @map("volatility_regime")
  /// TRENDING_UP | TRENDING_DOWN | RANGING | UNKNOWN
  trendRegime      String   @map("trend_regime")
  /// PROVIDER | CSV | MANUAL
  source           String   @default("CSV")
  computedAt       DateTime @default(now()) @map("computed_at")

  trade      Trade      @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([instrumentId, timeframe])
  @@map("market_context_snapshots")
}

/// Candle cache for ATR/regime computation — pruned to respect storage limits.
model PriceCandle {
  id           String   @id @default(cuid())
  instrumentId String   @map("instrument_id")
  /// M1 | M5 | M15 | M30 | H1 | H4 | D1 (v2.5 M2 — M1/M30 added; Zod-validated)
  timeframe    String
  openTime     DateTime @map("open_time") // UTC
  open         Decimal
  high         Decimal
  low          Decimal
  close        Decimal
  volume       Decimal?

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, timeframe, openTime])
  @@index([instrumentId, timeframe, openTime])
  @@map("price_candles")
}

// ── 4.12 Advanced prop firm tracking ────────────────────────────────────────

/// Editable rule set (global presets have userId = null and are read-only).
model PropFirmRuleSet {
  id             String   @id @default(cuid())
  userId         String?  @map("user_id")
  name           String
  firm           String
  /// JSON: per phase { profitTargetPercent, maxDailyLossPercent, maxTotalDrawdownPercent,
  /// drawdownType STATIC|TRAILING|EQUITY_BASED|BALANCE_BASED, minTradingDays, maxTradingDays,
  /// consistencyRulePercent, newsTradingRestricted, weekendHoldingAllowed, leverage }
  phases         String
  /// Local reset hour for daily loss (e.g. "22:00" for most firms = 00:00 CE(S)T)
  resetTimeLocal String   @default("00:00") @map("reset_time_local")
  timezone       String   @default("UTC")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user       User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges PropChallenge[]

  @@index([userId])
  @@map("prop_firm_rule_sets")
}

/// A prop firm challenge tracked against real trades (v2 §4.12).
model PropChallenge {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  accountId     String    @map("account_id")
  ruleSetId     String?   @map("rule_set_id")
  name          String
  firm          String
  /// PHASE_1 | PHASE_2 | FUNDED | FAILED | PASSED | ABANDONED
  currentPhase  String    @default("PHASE_1") @map("current_phase")
  accountSize   Decimal   @map("account_size")
  challengeFee  Decimal   @default(0) @map("challenge_fee")
  feeCurrency   String    @default("USD") @map("fee_currency")
  purchaseDate  DateTime? @map("purchase_date")
  startDate     DateTime  @default(now()) @map("start_date")
  endDate       DateTime? @map("end_date")
  /// IN_PROGRESS | PASSED | FAILED | ABANDONED
  status        String    @default("IN_PROGRESS")
  notes         String?
  /// JSON copy of the rule set at purchase — later edits never rewrite history
  rulesSnapshot String    @map("rules_snapshot")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account                    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ruleSet      PropFirmRuleSet?           @relation(fields: [ruleSetId], references: [id], onDelete: SetNull)
  phaseResults PropChallengePhaseResult[]
  payouts      PropPayout[]
  expenses     PropExpense[]
  alertStates  PropAlertState[]

  @@index([userId])
  @@index([accountId])
  @@map("prop_challenges")
}

/// Per-phase outcome of a challenge (v2 §4.12).
model PropChallengePhaseResult {
  id               String    @id @default(cuid())
  challengeId      String    @map("challenge_id")
  /// PHASE_1 | PHASE_2 | FUNDED
  phase            String
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  startingBalance  Decimal?  @map("starting_balance")
  endingBalance    Decimal?  @map("ending_balance")
  /// PASSED | FAILED | IN_PROGRESS
  result           String    @default("IN_PROGRESS")
  /// MAX_DAILY_LOSS | MAX_DRAWDOWN | TIME_LIMIT | RULE_VIOLATION | OTHER
  failReason       String?   @map("fail_reason")
  tradingDaysCount Int       @default(0) @map("trading_days_count")

  challenge PropChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("prop_challenge_phase_results")
}

/// Payout received on a challenge (v2 §4.12).
model PropPayout {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  challengeId        String    @map("challenge_id")
  requestedAt        DateTime  @default(now()) @map("requested_at")
  receivedAt         DateTime? @map("received_at")
  grossAmount        Decimal   @map("gross_amount")
  profitSplitPercent Decimal   @default(80) @map("profit_split_percent")
  netAmount          Decimal   @map("net_amount")
  currency           String    @default("USD")
  method             String?
  /// REQUESTED | RECEIVED | REJECTED
  status             String    @default("REQUESTED")
  note               String?

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge PropChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([challengeId])
  @@map("prop_payouts")
}

/// Other challenge costs: resets, add-ons, data fees (v2 §4.12).
model PropExpense {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  challengeId String?  @map("challenge_id")
  /// FEE | RESET | ADDON | OTHER
  type        String
  amount      Decimal
  currency    String   @default("USD")
  date        DateTime @default(now())
  note        String?

  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge PropChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([challengeId])
  @@map("prop_expenses")
}

/// Alert dedupe state — the same alert is never sent twice per day/type (v2 §4.12).
model PropAlertState {
  id             String    @id @default(cuid())
  challengeId    String    @map("challenge_id")
  /// DAILY_LOSS_80 | DRAWDOWN_80 | DAILY_LOSS_95 | DRAWDOWN_95 | MIN_DAYS_REACHED | TARGET_REACHED | BREACHED
  alertType      String    @map("alert_type")
  triggeredAt    DateTime  @default(now()) @map("triggered_at")
  /// Firm-day key (YYYY-MM-DD in the firm's timezone)
  dayKey         String    @map("day_key")
  acknowledgedAt DateTime? @map("acknowledged_at")

  challenge PropChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, alertType, dayKey])
  @@map("prop_alert_states")
}

// ═════════════════════════════════════════════════════════════════════════════
// v3 — Broker sync & import (schema §3.1)
// ═════════════════════════════════════════════════════════════════════════════

/// One MT4/MT5 terminal bound to one Account. The raw EA token is shown once
/// and stored only as an HMAC-SHA256 hash; the accountId always comes from the
/// connection row (never from the payload) so a token can never write into
/// another user's account.
model BrokerConnection {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  accountId           String    @map("account_id")
  platform            String // MT4 | MT5
  label               String
  tokenHash           String    @unique @map("token_hash")
  /// First 6 chars of the raw token — display only ("tj_a1b2c3…")
  tokenPrefix         String    @map("token_prefix")
  /// Bound at first heartbeat (server + login must never change afterwards)
  brokerServer        String?   @map("broker_server")
  brokerLogin         String?   @map("broker_login")
  /// PENDING | ACTIVE | STALE | MISMATCH | REVOKED
  status              String    @default("PENDING")
  lastHeartbeatAt     DateTime? @map("last_heartbeat_at")
  lastEventAt         DateTime? @map("last_event_at")
  eaVersion           String?   @map("ea_version")
  /// Start date for the EA history backfill (read via /ping)
  historyBackfillFrom DateTime? @map("history_backfill_from")
  autoMergeEnabled    Boolean   @default(false) @map("auto_merge_enabled")
  createdAt           DateTime  @default(now()) @map("created_at")
  revokedAt           DateTime? @map("revoked_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  syncEventLogs SyncEventLog[]

  @@index([userId])
  @@index([userId, status])
  @@map("broker_connections")
}

/// Idempotency + audit log for every ingest event. payloadJson is pruned
/// after 14 days by the daily cleanup.
model SyncEventLog {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  connectionId String    @map("connection_id")
  /// Idempotency key built by the EA (platform:server:login:type:ticket)
  eventId      String    @map("event_id")
  type         String
  receivedAt   DateTime  @default(now()) @map("received_at")
  processedAt  DateTime? @map("processed_at")
  /// PROCESSED | DUPLICATE | REJECTED | FAILED
  status       String
  errorCode    String?   @map("error_code")
  payloadJson  String?   @map("payload_json")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([userId, receivedAt])
  @@index([connectionId])
  @@map("sync_event_logs")
}

/// Broker symbol ("XAUUSDm", "GOLD") → Instrument. Unmapped symbols create a
/// pending mapping (instrumentId = "") the user confirms in the UI.
model SymbolMapping {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  brokerSymbol String   @map("broker_symbol")
  /// "" = pending (awaiting user confirmation)
  instrumentId String   @map("instrument_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brokerSymbol])
  @@index([userId])
  @@map("symbol_mappings")
}

/// EA magic number → Strategy auto-tagging.
model MagicNumberMapping {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  connectionId String?  @map("connection_id")
  magicNumber  String   @map("magic_number")
  strategyId   String   @map("strategy_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, connectionId])
  @@map("magic_number_mappings")
}

/// SL/TP/volume change history — feeds the "moved stop loss" analytics.
model TradeModification {
  id       String   @id @default(cuid())
  tradeId  String   @map("trade_id")
  userId   String   @map("user_id")
  time     DateTime
  /// STOP_LOSS | TAKE_PROFIT | VOLUME | OTHER
  field    String
  oldValue String?  @map("old_value")
  newValue String?  @map("new_value")
  /// EA_SYNC | MANUAL | IMPORT
  source   String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tradeId, time])
  @@map("trade_modifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// v2.5 Module 5 — trading tools
// (Client persistence is localStorage until `prisma generate` runs on the
// user's PC; the shapes in src/lib/tools/store.ts mirror these models.)
// ─────────────────────────────────────────────────────────────────────────────

/// Saved calculator scenario (multi-TP sizing, margin what-if, ...).
model ToolScenario {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  /// MULTI_TP | MARGIN | RISK_REWARD
  kind      String
  /// JSON: calculator inputs (payload shape depends on kind).
  payloadJson String @map("payload_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("tool_scenarios")
}

/// Manual / CSV-imported FX rate: 1 base = rate quote.
model FxRate {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  baseCurrency  String   @map("base_currency")
  quoteCurrency String   @map("quote_currency")
  rate          Decimal
  /// MANUAL | CSV
  source        String   @default("MANUAL")
  /// Date the rate applies to.
  rateDate      DateTime @map("rate_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, baseCurrency, quoteCurrency])
  @@index([userId])
  @@map("fx_rates")
}

/// Market session setting: DISPLAY (IANA clock sessions) or DETECTION
/// (session ranges used by detectSession, legacy UTC ranges by default).
model MarketSessionSetting {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  /// DISPLAY | DETECTION
  kind       String   @default("DISPLAY")
  /// IANA zone (e.g. Europe/London) or "UTC".
  timezone   String   @default("UTC")
  /// Local "HH:MM" open / close in the session timezone.
  openTime   String   @map("open_time")
  closeTime  String   @map("close_time")
  /// JSON array of ISO weekdays 1 = Monday ... 7 = Sunday.
  activeDays String   @default("[1,2,3,4,5]") @map("active_days")
  isEnabled  Boolean  @default(true) @map("is_enabled")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("market_session_settings")
}

/// Partial exit plan: tiers (% + price or R target), breakeven / trailing.
model ExitPlan {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  name               String
  /// JSON: ExitPlanTier[] { pct, targetType: PRICE | R, target }.
  tiersJson          String   @map("tiers_json")
  /// Move SL to breakeven after this tier index (0-based), null = never.
  breakevenAfterTier Int?     @map("breakeven_after_tier")
  /// Start trailing after this tier index (0-based), null = never.
  trailingAfterTier  Int?     @map("trailing_after_tier")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId])
  @@map("exit_plans")
}

/// Exposure alert thresholds (one row per user).
model ExposureAlertSetting {
  id                            String   @id @default(cuid())
  userId                        String   @unique @map("user_id")
  enabled                       Boolean  @default(true)
  /// Same currency, same direction, 2+ positions, above this % of balance.
  duplicationThresholdPercent   Decimal  @default(2) @map("duplication_threshold_percent")
  /// One currency above this % of balance (same direction) warns.
  maxCurrencyExposurePercent    Decimal  @default(5) @map("max_currency_exposure_percent")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("exposure_alert_settings")
}

/// Equity curve samples fed by EA heartbeats. Retention: 15-min granularity
/// for 30 days, downsampled to daily afterwards (cleanup job).
model AccountEquitySnapshot {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  accountId String   @map("account_id")
  time      DateTime
  balance   Decimal
  equity    Decimal
  margin    Decimal?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, time])
  @@index([accountId, time])
  @@map("account_equity_snapshots")
}

/// One uploaded history file (browser-parsed, chunked import).
model ImportBatch {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  accountId      String   @map("account_id")
  /// MT4_HTML | MT5_HTML | MT5_XLSX | MT5_CSV | CTRADER_CSV | CTRADER_XLSX | TRADINGVIEW_CSV | GENERIC_CSV
  format         String
  fileName       String   @map("file_name")
  /// SHA-256 of the file — warns on re-upload of an identical file
  fileHash       String   @map("file_hash")
  /// PREVIEW | IMPORTED | PARTIAL | FAILED
  status         String   @default("PREVIEW")
  /// JSON: { parsed, created, updated, duplicates, errors }
  countsJson     String   @default("{}") @map("counts_json")
  /// IANA timezone the user declared for the file's timestamps
  serverTimezone String   @map("server_timezone")
  createdAt      DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, fileHash])
  @@index([accountId])
  @@map("import_batches")
}

/// Manual trade vs broker trade probable-duplicate pair (matcher output).
model ReconciliationCandidate {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  accountId     String    @map("account_id")
  manualTradeId String    @map("manual_trade_id")
  brokerTradeId String    @map("broker_trade_id")
  /// 0-1 matcher score
  score         Decimal
  /// JSON: [{ code, weight, detail }] human-readable reasons
  reasonsJson   String    @map("reasons_json")
  /// PENDING | MERGED | REJECTED_NOT_DUPLICATE | KEPT_SEPARATE
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now()) @map("created_at")
  resolvedAt    DateTime? @map("resolved_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([manualTradeId, brokerTradeId])
  @@index([userId, status])
  @@index([accountId])
  @@map("reconciliation_candidates")
}

/// Merge audit trail with a full snapshot of the absorbed trade (undo ≤ 30 d).
model TradeMergeLog {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  survivingTradeId      String    @map("surviving_trade_id")
  /// JSON: absorbed trade + child rows (purged after expiresAt)
  absorbedTradeSnapshot String    @map("absorbed_trade_snapshot")
  /// JSON: which side won per field
  fieldChoicesJson      String    @map("field_choices_json")
  mergedAt              DateTime  @default(now()) @map("merged_at")
  undoneAt              DateTime? @map("undone_at")
  expiresAt             DateTime  @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([survivingTradeId])
  @@map("trade_merge_logs")
}

// ═════════════════════════════════════════════════════════════════════════════
// v3 — Sharing & collaboration (schema §3.2)
// ═════════════════════════════════════════════════════════════════════════════

/// Public read-only share link (trade or report). Token hashed at rest,
/// revocable instantly, redaction applied server-side BEFORE any payload is
/// built (SNAPSHOT stores already-redacted content).
model ShareLink {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  /// TRADE | REPORT
  type          String
  targetId      String    @map("target_id")
  tokenHash     String    @unique @map("token_hash")
  tokenPrefix   String    @map("token_prefix")
  title         String
  /// SNAPSHOT (default) | LIVE
  mode          String    @default("SNAPSHOT")
  /// Already-redacted content when mode = SNAPSHOT
  snapshotJson  String?   @map("snapshot_json")
  /// JSON RedactionPolicy (hideAmounts, hideAccountInfo, …)
  redactionJson String    @map("redaction_json")
  expiresAt     DateTime  @map("expires_at")
  maxViews      Int?      @map("max_views")
  viewCount     Int       @default(0) @map("view_count")
  lastViewedAt  DateTime? @map("last_viewed_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("share_links")
}

/// Single-use mentor invitation (email must match the invitee's account).
model MentorInvitation {
  id              String   @id @default(cuid())
  ownerId         String   @map("owner_id")
  inviteeEmail    String   @map("invitee_email")
  tokenHash       String   @unique @map("token_hash")
  /// JSON: MentorAccess scope fields (accountScope, strategyScope, flags…)
  permissionsJson String   @map("permissions_json")
  /// PENDING | ACCEPTED | DECLINED | EXPIRED | REVOKED
  status          String   @default("PENDING")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  owner User @relation("InvitationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([inviteeEmail])
  @@map("mentor_invitations")
}

/// Granted mentor access — scope editable, pausable, revocable at any time
/// with immediate effect.
model MentorAccess {
  id                 String    @id @default(cuid())
  ownerId            String    @map("owner_id")
  mentorId           String    @map("mentor_id")
  /// ACTIVE | PAUSED | REVOKED
  status             String    @default("ACTIVE")
  /// ALL | LIST
  accountScope       String    @default("ALL") @map("account_scope")
  /// JSON string[] — meaningful when accountScope = LIST
  accountIdsJson     String    @default("[]") @map("account_ids_json")
  /// ALL | LIST
  strategyScope      String    @default("ALL") @map("strategy_scope")
  strategyIdsJson    String    @default("[]") @map("strategy_ids_json")
  canViewAmounts     Boolean   @default(true) @map("can_view_amounts")
  canViewJournal     Boolean   @default(false) @map("can_view_journal")
  canViewScreenshots Boolean   @default(false) @map("can_view_screenshots")
  canViewAnalytics   Boolean   @default(true) @map("can_view_analytics")
  canComment         Boolean   @default(false) @map("can_comment")
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  revokedAt          DateTime? @map("revoked_at")
  lastViewedAt       DateTime? @map("last_viewed_at")

  owner  User @relation("MentorAccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  mentor User @relation("MentorAccessMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([ownerId, mentorId])
  @@index([mentorId])
  @@index([ownerId, status])
  @@map("mentor_accesses")
}

/// Aggregated per-day view counts — privacy transparency for the owner.
model MentorAccessLog {
  id           String  @id @default(cuid())
  ownerId      String  @map("owner_id")
  mentorId     String  @map("mentor_id")
  /// TRADES | TRADE_DETAIL | JOURNAL | ANALYTICS | ACCOUNTS
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id")
  /// YYYY-MM-DD (UTC)
  day          String
  viewCount    Int     @default(0) @map("view_count")

  @@unique([ownerId, mentorId, resourceType, resourceId, day])
  @@index([ownerId])
  @@index([mentorId])
  @@map("mentor_access_logs")
}

/// Comment thread on a trade (owner + mentors with canComment).
model TradeComment {
  id        String    @id @default(cuid())
  tradeId   String    @map("trade_id")
  /// Journal owner (the trade's owner — denormalized for fast scope checks)
  ownerId   String    @map("owner_id")
  authorId  String    @map("author_id")
  /// One level of threading
  parentId  String?   @map("parent_id")
  /// Restricted markdown, max 4000 chars
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")
  /// Soft-delete tombstone (kept when the comment has replies)
  deletedAt DateTime? @map("deleted_at")

  author User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([ownerId])
  @@index([authorId])
  @@map("trade_comments")
}

/// Mention rows — only users who currently have access to that trade.
model CommentMention {
  commentId       String @map("comment_id")
  mentionedUserId String @map("mentioned_user_id")

  @@id([commentId, mentionedUserId])
  @@index([mentionedUserId])
  @@map("comment_mentions")
}

/// Unread tracking per user per trade.
model CommentReadState {
  userId     String   @map("user_id")
  tradeId    String   @map("trade_id")
  lastReadAt DateTime @map("last_read_at")

  @@id([userId, tradeId])
  @@index([userId])
  @@map("comment_read_states")
}

// ═════════════════════════════════════════════════════════════════════════════
// v3 — Compliance (schema §3.3)
// ═════════════════════════════════════════════════════════════════════════════

/// Append-only consent history (terms, privacy, cookies, marketing).
model ConsentRecord {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  /// TERMS | PRIVACY | COOKIES_PREFERENCES | MARKETING_EMAIL
  type        String
  /// e.g. "2025-01-01"
  version     String
  granted     Boolean
  /// JSON cookie-category choices when type = COOKIES_PREFERENCES
  choicesJson String?  @map("choices_json")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("consent_records")
}

/// Scheduled account deletion (7-day grace, cancellable, idempotent cron).
model AccountDeletionRequest {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  requestedAt  DateTime  @default(now()) @map("requested_at")
  scheduledFor DateTime  @map("scheduled_for")
  /// PENDING | PROCESSING (completedAt is the lease timestamp) | CANCELLED | COMPLETED
  status       String    @default("PENDING")
  completedAt  DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_deletion_requests")
}

/// Minimal non-personal tombstone kept after deletion (audit).
model DeletedUserTombstone {
  /// HMAC-SHA256 of the user id with TOKEN_PEPPER — not reversible
  id          String   @id
  completedAt DateTime @map("completed_at")

  @@map("deleted_user_tombstones")
}

/// Export history (full ZIP backups).
model DataExportLog {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  /// FULL | PARTIAL
  kind          String
  sizeBytes     Int?     @map("size_bytes")
  schemaVersion String   @map("schema_version")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("data_export_logs")
}

/// PostgreSQL-backed fixed-window rate limiter (no Redis on free tier).
/// Keys are already hashed (token / HMAC-of-IP) — no raw identifiers stored.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @map("window_start")
  count       Int

  @@map("rate_limit_buckets")
}

// ─────────────────────────────────────────────────────────────────────────────
// v2.5 Module 1 — Customizable dashboards
// ─────────────────────────────────────────────────────────────────────────────

/// A named dashboard tab (max 8 per user). Widgets live in DashboardWidget.
model Dashboard {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  /// Lucide icon key shown in the tab (see src/lib/dashboard/icons.ts).
  icon          String   @default("layout-dashboard")
  order         Int      @default(0)
  isDefault     Boolean  @default(false) @map("is_default")
  /// Built-in template key this dashboard was created from (audit/UX hint).
  templateKey   String?  @map("template_key")
  /// Layout JSON schema version — migrations hook (src/lib/dashboard/layout.ts).
  layoutVersion Int      @default(1) @map("layout_version")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgets DashboardWidget[]

  @@index([userId])
  @@map("dashboards")
}

/// One widget instance on a dashboard (max 24 per dashboard).
/// config/layouts/periodOverride are JSON strings validated by Zod at the edge.
model DashboardWidget {
  id              String   @id @default(cuid())
  dashboardId     String   @map("dashboard_id")
  userId          String   @map("user_id")
  /// Registry key — see src/lib/dashboard/registry.ts.
  type            String
  /// Optional display title override (null = widget default name).
  title           String?
  /// JSON validated by the widget's configSchema.
  config          String   @default("{}")
  /// JSON per breakpoint: { x, y, w, h } for lg/md/sm (mobile stacks, order only).
  layouts         String
  /// JSON PeriodOverride (mode + values + compareToPrevious); null = inherit.
  periodOverride  String?  @map("period_override")
  /// Account id filter override; null = inherit the global filter.
  accountOverride String?  @map("account_override")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dashboardId])
  @@map("dashboard_widgets")
}

/// Reusable user-defined metric (aggregate + filters + optional formula AST).
model CustomMetric {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?
  /// JSON MetricDefinition — { aggregate, filters, formula? } (Zod validated).
  definition  String
  /// NUMBER | CURRENCY | PERCENT | R | PIPS | DURATION
  format      String   @default("NUMBER")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("custom_metrics")
}

/// "Save as my template" — user-owned dashboard blueprints (versioned JSON,
/// no personal data).
model UserDashboardTemplate {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  name           String
  description    String?
  /// Versioned dashboard definition JSON (same shape as import/export files).
  definitionJson String   @map("definition_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_dashboard_templates")
}

/// One row per user — appearance overrides (palette, density, KPI defaults).
model UserAppearance {
  /// === users.id
  userId          String   @id @map("user_id")
  /// default | colorblind | deuteranopia | protanopia | monochrome | high-contrast | custom
  paletteKey      String   @default("default") @map("palette_key")
  /// Custom palette overrides (hex) — only used when paletteKey = custom.
  gainColor       String?  @map("gain_color")
  lossColor       String?  @map("loss_color")
  neutralColor    String?  @map("neutral_color")
  /// COMPACT | COMFORTABLE | SPACIOUS
  density         String   @default("COMFORTABLE")
  /// Categorical chart palette key.
  chartPaletteKey String   @default("default") @map("chart_palette_key")
  /// JSON — default KPI selection/order/options for new KPI strips.
  kpiDefaults     String   @default("{}") @map("kpi_defaults")
  /// JSON — focus mode block configuration (nullable = defaults).
  focusModeConfig String?  @map("focus_mode_config")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_appearances")
}

// ─────────────────────────────────────────────────────────────────────────────
// v2.5 Module 2 — Advanced charts (saved charts, annotations, benchmarks)
// ─────────────────────────────────────────────────────────────────────────────

/// A saved chart-builder definition (name + validated config JSON).
model SavedChart {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  /// JSON ChartConfig (Zod validated at the edge — /src/lib/validations/charts.ts).
  configJson String   @map("config_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_charts")
}

/// Point or range annotation on time-based charts (equity, builder X = date…).
model ChartAnnotation {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  /// UTC timestamp (point start, or range start when endDate set).
  date       DateTime
  /// UTC timestamp (exclusive end) — null = point annotation.
  endDate    DateTime? @map("end_date")
  label      String
  note       String?
  /// STRATEGY_CHANGE | VACATION | BAD_PERIOD | NEWS | RULE_CHANGE | OTHER
  kind       String    @default("OTHER")
  color      String?
  /// GLOBAL | ACCOUNT | STRATEGY (an annotation applies only to charts
  /// matching its scope — see /src/lib/charts/scoping.ts).
  scope      String    @default("GLOBAL")
  accountId  String?   @map("account_id")
  strategyId String?   @map("strategy_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("chart_annotations")
}

/// Equity-curve benchmark definition (fixed %/period, fixed R/period, custom CSV).
model BenchmarkProfile {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  /// FIXED_PERCENT_PER_PERIOD | FIXED_R_PER_PERIOD | CUSTOM_SERIES
  type       String
  /// JSON BenchmarkParams — { percent?, rPerPeriod?, period: MONTH|WEEK|YEAR,
  /// compounding?, startDate, startBalance? } (Zod validated).
  params     String
  /// Imported custom series — JSON [{ date, value }] (nullable).
  seriesJson String?  @map("series_json")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("benchmark_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// v2.5 Module 4 — Productivity & ergonomics
// ─────────────────────────────────────────────────────────────────────────────

/// User rebinding of a shortcut-able action (§4.1). Unique per (user, action).
/// `keys` is a normalized chord/sequence string, e.g. "mod+k", "g d", "?".
model KeyboardShortcut {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  actionId  String   @map("action_id")
  keys      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, actionId])
  @@index([userId])
  @@map("keyboard_shortcuts")
}

/// Per-table column layout (§4.8): order, visibility, sizing, pinning, density.
/// One row per (user, tableKey); saved views may override per view.
model TableColumnPreference {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  tableKey     String   @map("table_key")
  /// JSON string[] — ordered column ids.
  columnOrder  String   @map("column_order")
  /// JSON { [columnId]: boolean }.
  columnVisibility String @map("column_visibility")
  /// JSON { [columnId]: number } (px).
  columnSizing String   @map("column_sizing")
  /// JSON { left?: string[], right?: string[] }.
  pinning      String
  /// compact | normal | comfortable (nullable = table default).
  density      String?
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tableKey])
  @@index([userId])
  @@map("table_column_preferences")
}

/// User-defined custom field on trades (§4.7). Max 30 active per user+entity.
/// Values live in Trade.customFields JSONB keyed by `key`.
model CustomFieldDefinition {
  id        String    @id @default(cuid())
  userId    String   @map("user_id")
  /// TRADES (only entity for now — schema-ready for more).
  entity    String
  /// Slug key, unique per (user, entity).
  key       String
  label     String
  /// TEXT | LONG_TEXT | NUMBER | DECIMAL | SELECT | MULTI_SELECT | CHECKBOX | DATE | URL
  type      String
  /// JSON: { values: string[], colors?: { [value]: string } } for selects.
  options   String?
  required  Boolean  @default(false)
  /// JSON-encoded default value (type-checked by the dynamic Zod schema).
  defaultValue String? @map("default_value")
  order     Int      @default(0)
  showInTable Boolean @default(false) @map("show_in_table")
  showInQuickForm Boolean @default(false) @map("show_in_quick_form")
  usableInAnalytics Boolean @default(false) @map("usable_in_analytics")
  archivedAt DateTime? @map("archived_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entity, key])
  @@index([userId, entity])
  @@map("custom_field_definitions")
}

/// Command-style change log powering undo/redo (§4.5). Compact JSON
/// snapshots, pruned after 30 days by the daily cron (expiresAt).
model ChangeLog {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  /// Groups several entries into ONE undoable action (e.g. a bulk edit or a
  /// batch entry of 10 trades = one group).
  groupId    String    @map("group_id")
  /// TRADE | JOURNAL_ENTRY | STRATEGY | TAG | …
  entity     String
  entityId   String    @map("entity_id")
  /// CREATE | UPDATE | DELETE | RESTORE | BULK_UPDATE
  action     String
  /// JSON snapshot before the change (null for CREATE).
  beforeJson String?   @map("before_json")
  /// JSON snapshot after the change (null for DELETE).
  afterJson  String?   @map("after_json")
  /// UI | BULK | IMPORT — where the change came from.
  source     String    @default("UI")
  undoneAt   DateTime? @map("undone_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, groupId])
  @@index([userId, expiresAt])
  @@map("change_logs")
}

/// Autosaved spreadsheet batch-entry draft (§4.11) — one active draft per user.
model BatchEntryDraft {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  accountId String   @map("account_id")
  /// JSON: batch rows (validated loosely client-side, strictly on save).
  rowsJson  String   @map("rows_json")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("batch_entry_drafts")
}

// ─────────────────────────────────────────────────────────────────────────────
// v2.5 Module 8 — Privacy mode, accessibility & time zones
// ─────────────────────────────────────────────────────────────────────────────

/// One row per user — display preferences (privacy / accessibility / time).
/// The privacy and a11y slices are ALSO mirrored to localStorage on every
/// device for instant apply and pre-paint; a device with a stored value wins
/// until the user changes it there (per-device override), then the server row
/// is updated too (see /src/components/privacy + /src/components/a11y).
///
/// PRIVACY MODE IS A DISPLAY-ONLY CONVENIENCE, NOT A SECURITY CONTROL — the
/// data is still present in the page source and network responses. For real
/// hiding use v3 share links (server-side redaction) or the anonymized export.
model UserDisplayPreference {
  /// === users.id
  userId String @id @map("user_id")

  // ── Privacy (§3.1 / §3.2) ──
  /// OFF | HIDE | BLUR
  privacyMode String @default("OFF") @map("privacy_mode")
  /// JSON PrivacyScope — which value kinds are affected in HIDE/BLUR mode.
  privacyScope String @default("{\"hideCurrencyAmounts\":true,\"hideLots\":false,\"hideBalances\":true,\"hideAccountNames\":false,\"hideBrokerInfo\":false,\"hidePercentages\":false,\"hideRAndPips\":false}") @map("privacy_scope")
  /// JSON PrivacyAutoEnable — { onWindowBlur, onInactivitySeconds }.
  privacyAutoEnable String @default("{\"onWindowBlur\":false,\"onInactivitySeconds\":null}") @map("privacy_auto_enable")
  /// Normalized chord string for the privacy toggle (default "shift+h").
  privacyShortcut String @default("shift+h") @map("privacy_shortcut")
  /// Blur trade screenshots too while privacy mode is on (they may show balances).
  blurScreenshots Boolean @default(false) @map("blur_screenshots")
  /// Reveal blurred values on hover/focus (BLUR mode).
  revealOnHover Boolean @default(true) @map("reveal_on_hover")
  /// Redact amounts in server-composed notification/push/email bodies
  /// (R multiples / pips only, same policy as the display scope).
  hideAmountsInNotifications Boolean @default(false) @map("hide_amounts_in_notifications")

  // ── Accessibility (§3.3) ──
  /// Root font-size percent, 80–200 (presets: 90 / 100 / 130 / 160).
  textScale Int @default(100) @map("text_scale")
  /// STANDARD | HIGH | SYSTEM (follows prefers-contrast).
  contrastMode String @default("SYSTEM") @map("contrast_mode")
  /// SYSTEM (follows prefers-reduced-motion) | ON | OFF.
  reducedMotion String @default("SYSTEM") @map("reduced_motion")
  /// DEFAULT | DYSLEXIA_FRIENDLY (system font stack) | MONO_NUMBERS.
  fontFamily String @default("DEFAULT") @map("font_family")
  /// Line height percent 100–200 (null = theme default).
  lineHeight Int?
  /// Letter spacing per-mille −50…200 (null = theme default).
  letterSpacing Int? @map("letter_spacing")
  /// STANDARD | ENHANCED (thicker, always-visible focus ring).
  focusRingStyle String @default("STANDARD") @map("focus_ring_style")
  /// Enforce ≥ 44px touch targets on primary controls.
  largerTouchTargets Boolean @default(false) @map("larger_touch_targets")
  /// Underline all links.
  underlineLinks Boolean @default(false) @map("underline_links")
  /// Tabular (monospaced) digits everywhere.
  tabularNumbers Boolean @default(false) @map("tabular_numbers")

  // ── Time zones & trading day (§3.4) ──
  /// JSON ExtraTimezone[] (max 3): { label, ianaTimezone, kind }.
  extraTimezones String @default("[]") @map("extra_timezones")
  /// 12H | 24H | LOCALE.
  timeFormat String @default("LOCALE") @map("time_format")
  /// 0 = Sunday | 1 = Monday | 6 = Saturday.
  weekStartsOn Int @default(1) @map("week_starts_on")
  /// MIDNIGHT_LOCAL | NEW_YORK_CLOSE (17:00 America/New_York) | CUSTOM.
  tradingDayRolloverMode String @default("MIDNIGHT_LOCAL") @map("trading_day_rollover_mode")
  /// "HH:MM" when mode = CUSTOM.
  tradingDayRolloverTime String? @map("trading_day_rollover_time")
  /// IANA zone when mode = CUSTOM.
  tradingDayRolloverTimezone String? @map("trading_day_rollover_timezone")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_display_preferences")
}

// ═════════════════════════════════════════════════════════════════════════════
// Gaïa — workspace de notes
// ═════════════════════════════════════════════════════════════════════════════
// Réplique du workspace Nofy d'Euforia, adaptée aux tables Prisma de Promethe
// (une table par entité, JSON stocké en String comme Trade.customFields).
// Le contenu humain est en français ; les ids machine restent en anglais.
// ─────────────────────────────────────────────────────────────────────────────

/// Une note Gaïa : titre, dossier, tags, blocs JSON (voir src/lib/gaia/content.ts).
model Note {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  title        String    @default("")
  icon         String?
  folderId     String?   @map("folder_id")
  /// JSON string[] des ids de NoteTag.
  tagIds       String    @default("[]") @map("tag_ids")
  favorite     Boolean   @default(false)
  templateId   String?   @map("template_id")
  /// JSON GaiaBlock[] (contenu éditorial, jamais de HTML brut).
  blocks       String    @default("[]")
  lastViewedAt DateTime? @map("last_viewed_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   NoteFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions NoteVersion[]

  @@index([userId])
  @@index([userId, folderId])
  @@map("gaia_notes")
}

/// Dossier de notes (nom unique par utilisateur, insensible à la casse).
model NoteFolder {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]

  @@index([userId])
  @@map("gaia_folders")
}

/// Tag de notes (nom unique par utilisateur, insensible à la casse, "#" retiré).
model NoteTag {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gaia_tags")
}

/// Modèle de note créé par l'utilisateur. Les 5 modèles built-in (tpl-...)
/// vivent dans le code (src/lib/gaia/templates.ts) et ne sont jamais persistés.
model NoteTemplate {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String   @default("")
  icon        String   @default("📄")
  /// JSON GaiaBlock[] (les blocs ref sont supprimés à la création).
  blocks      String   @default("[]")
  builtIn     Boolean  @default(false) @map("built_in")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gaia_templates")
}

/// Snapshot immuable d'une note avant modification (versioning, cap 12).
model NoteVersion {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  noteId    String   @map("note_id")
  title     String   @default("")
  /// JSON GaiaBlock[] tels qu'avant la modification.
  blocks    String   @default("[]")
  /// = updatedAt de la note AVANT la modification.
  savedAt   DateTime @map("saved_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([userId, noteId])
  @@index([noteId, savedAt])
  @@map("gaia_versions")
}

// ═════════════════════════════════════════════════════════════════════════════
// v2.5 Module 6 — advanced analytics (Prompt 6)
// ═════════════════════════════════════════════════════════════════════════════

/// Per-trade lifecycle stats, persisted by GET /api/analytics/advanced
/// (idempotent upsert from the stored MFE/MAE prices and, when stored
/// candles cover the trade window, from the price path). timeInProfitMin /
/// timeInLossMin stay null without candle coverage — never invented.
model TradeLifecycleStats {
  id              String   @id @default(cuid())
  tradeId         String   @unique @map("trade_id")
  userId          String   @map("user_id")
  /// MFE in R (from mfePrice + initial SL), null when not computable.
  mfeR            Decimal? @map("mfe_r")
  /// MAE in R (adverse distance), null when not computable.
  maeR            Decimal? @map("mae_r")
  /// Minutes spent in profit / in loss (candle closes vs entry price).
  timeInProfitMin Int?     @map("time_in_profit_min")
  timeInLossMin   Int?     @map("time_in_loss_min")
  /// Price came within 90 % of the planned RR target without touching TP.
  almostTp        Boolean  @default(false) @map("almost_tp")
  computedAt      DateTime @default(now()) @map("computed_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, computedAt])
  @@map("trade_lifecycle_stats")
}

/// Daily trader quality score snapshot (0-100) with its four components.
/// Written by the daily cron (all users) and by GET /api/analytics/advanced
/// (today's row, idempotent upsert). History in the UI is a deterministic
/// month-end replay over closed trades — snapshots only freeze the value.
model TraderScoreSnapshot {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  /// Day (UTC midnight) the snapshot describes.
  date        DateTime @map("date")
  /// Composite score 0-100.
  score       Int
  /// Components, each 0-25.
  discipline  Int
  edge        Int
  consistency Int
  risk        Int
  /// Closed trades the score is based on.
  tradeCount  Int      @map("trade_count")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("trader_score_snapshots")
}

/// Detected trade anomaly (robust MAD z-score on R or on log-duration).
/// Recomputed by GET /api/analytics/advanced (idempotent refresh for the
/// trades in scope). No entry-time alerts are ever raised from these rows.
model TradeAnomaly {
  id         String   @id @default(cuid())
  tradeId    String   @map("trade_id")
  userId     String   @map("user_id")
  /// R_OUTLIER | DURATION_OUTLIER
  kind       String
  /// high (|z| >= 3) | moderate (|z| >= 2)
  severity   String
  zScore     Decimal  @map("z_score")
  detectedAt DateTime @default(now()) @map("detected_at")

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tradeId, kind])
  @@index([userId, detectedAt])
  @@map("trade_anomalies")
}

/// Weekly improvement plan (MRT wave 1) — one row per generated action of
/// the current week (Monday-Sunday). The title and target are snapshots of
/// the rule output at generation time; `done` is the user's own checkbox
/// state for that week. Rows are upserted on every GET and stale rows of
/// the week (rules that no longer fire) are removed, so the table always
/// mirrors the live plan. No grade data is stored here.
model WeeklyPlanAction {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  accountId String?  @map("account_id")
  /// "__all__" for the global plan, otherwise the selected account ID.
  scopeKey  String   @default("__all__") @map("scope_key")
  /// Monday of the week, UTC midnight.
  weekStart DateTime @map("week_start")
  /// Stable rule key from the engine (worst-session, worst-hour, ...).
  rule      String
  /// Snapshot of the generated action title at generation time.
  title     String
  /// Snapshot of the measurable target at generation time.
  target    String
  done      Boolean  @default(false)
  doneAt    DateTime? @map("done_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart, scopeKey, rule])
  @@index([userId, weekStart, scopeKey])
  @@map("weekly_plan_actions")
}

// ─────────────────────────────────────────────────────────────────────────────
// v2.5 Module 9 — Discord / Telegram integrations (Prompt 9)
// ─────────────────────────────────────────────────────────────────────────────

/// One outbound destination owned by a user: a Discord webhook URL or a
/// Telegram bot token (+ chat id). The secret is stored ONLY as AES-256-GCM
/// ciphertext (see src/lib/integrations/crypto.ts) and is never returned by
/// any API — only secretHint (display only) ever reaches the client.
model IntegrationEndpoint {
  id     String @id @default(cuid())
  userId String @map("user_id")
  /// DISCORD_WEBHOOK | TELEGRAM_BOT
  type  String
  label String
  /// AES-256-GCM ciphertext, format "v1:<iv hex>:<tag hex>:<cipher hex>".
  secretEncrypted String @map("secret_encrypted")
  /// Display hint only: "discord.com" for Discord, last 4 chars of the
  /// token ("••••abcd") for Telegram. Never a usable secret fragment.
  secretHint String @map("secret_hint")
  /// Telegram chat id (numeric id or @channelusername). Null for Discord.
  chatId String? @map("chat_id")
  isEnabled Boolean @default(true) @map("is_enabled")
  /// Consecutive failed sends; the endpoint auto-disables at 5.
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastErrorAt       DateTime? @map("last_error_at")
  lastSentAt        DateTime? @map("last_sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions IntegrationSubscription[]
  messages      OutboundMessage[]

  @@index([userId])
  @@map("integration_endpoints")
}

/// One event a user wants on one endpoint, with its privacy level and quiet
/// hours. Created automatically (all 3 events, FULL, enabled) when an
/// endpoint is added; the user then tunes or disables each row.
model IntegrationSubscription {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  endpointId String @map("endpoint_id")
  /// DAILY_SUMMARY | DRAWDOWN_ALERT | PROP_ALERT
  eventType String @map("event_type")
  /// FULL | NO_AMOUNTS | MINIMAL
  privacyLevel String  @default("FULL") @map("privacy_level")
  /// HH:mm local, null = no quiet hours. Daily summaries are deferred past
  /// quiet hours; drawdown / prop alerts always go out.
  quietHoursStart String? @map("quiet_hours_start")
  quietHoursEnd   String? @map("quiet_hours_end")
  isEnabled Boolean @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint IntegrationEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventType])
  @@index([userId])
  @@map("integration_subscriptions")
}

/// Outbox for outbound Discord / Telegram messages. The cron worker
/// (/api/cron/integrations) drains PENDING rows; dedupeKey makes every
/// enqueue idempotent (one daily summary per user, endpoint and day; one
/// alert per threshold per day). payloadJson holds the structured event
/// data + privacy level — rendering happens at send time, per endpoint type.
model OutboundMessage {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  endpointId String @map("endpoint_id")
  /// DAILY_SUMMARY | DRAWDOWN_ALERT | PROP_ALERT | TEST
  eventType String @map("event_type")
  /// e.g. daily-summary:<userId>:<endpointId>:2026-11-17
  dedupeKey String @unique @map("dedupe_key")
  /// JSON string: { eventType, privacyLevel, data }
  payloadJson String @map("payload_json")
  /// PENDING | SENT | FAILED | DEAD
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  lastError String? @map("last_error")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint IntegrationEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@map("outbound_messages")
}
