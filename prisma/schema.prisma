// Promethe — Prisma schema for PostgreSQL / Supabase.
// Conventions:
//  - snake_case DB columns via @map, camelCase in TS
//  - Decimal for ALL money / price / lots / pip values (never floats)
//  - Status-like columns are String, validated by Zod at the edge
//  - Lists (timeframes, sessions, checklist results) are JSON-encoded strings
//    for predictable PostgreSQL compatibility.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

