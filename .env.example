# Promethe — example environment. Copy to .env and fill in your own values.
# NEVER commit a real .env (the repo is public).

# Supabase Postgres (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase Postgres (Session pooler, port 5432 — used for migrations / db push)
DIRECT_URL=postgresql://postgres:YOUR_DB_PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# Auth / hashing peppers (generate with: openssl rand -hex 32)
TOKEN_PEPPER=YOUR_TOKEN_PEPPER
IP_HASH_PEPPER=YOUR_IP_HASH_PEPPER

# Google sign-in (OAuth client, Testing mode)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Cron endpoints (Bearer token — generate a long random secret)
CRON_SECRET=YOUR_CRON_SECRET

# Discord / Telegram integration secrets, AES-256-GCM key (generate with: openssl rand -hex 32)
INTEGRATION_ENCRYPTION_KEY=YOUR_INTEGRATION_ENCRYPTION_KEY

# Public base URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
