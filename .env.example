# Promethe — example environment. Copy to .env and fill in your own values.
# NEVER commit a real .env (the repo is public).

# Supabase Postgres — application connection (Production / Preview)
# Transaction pooler, port 6543
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public
# Session pooler, port 5432 — migrations / db push
DIRECT_URL=postgresql://postgres:YOUR_DB_PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?schema=public

# Supabase Postgres — TEST ONLY, same Supabase project but isolated schema.
# Create the schema "promethe_test" once; never point these URLs at schema=public.
# Transaction pooler, port 6543
TEST_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=promethe_test
# Session pooler, port 5432 — Prisma db push for the test schema
TEST_DIRECT_URL=postgresql://postgres:YOUR_DB_PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?schema=promethe_test

# Supabase Storage — server-only credentials; NEVER expose the service role key to the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=trade-screenshots

# Auth / hashing peppers (generate with: openssl rand -hex 32)
TOKEN_PEPPER=YOUR_TOKEN_PEPPER
IP_HASH_PEPPER=YOUR_IP_HASH_PEPPER

# Google sign-in. Register this exact URI in Google Cloud Console.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
# In local development, GOOGLE_REDIRECT_URI may be omitted; localhost:3000 is used.

# Cron endpoints (Bearer token — generate a long random secret)
CRON_SECRET=YOUR_CRON_SECRET

# Discord / Telegram integration secrets, AES-256-GCM key (generate with: openssl rand -hex 32)
INTEGRATION_ENCRYPTION_KEY=YOUR_INTEGRATION_ENCRYPTION_KEY

# Economic calendar - optional. Free key at fred.stlouisfed.org (no card).
# Without it the FRED source reports "Not configured" and the app still works.
FRED_API_KEY=YOUR_FRED_API_KEY

# Legal pages - optional. Shown on /legal/*; neutral fallbacks are used when unset.
LEGAL_ENTITY_NAME=YOUR_LEGAL_ENTITY_NAME
LEGAL_CONTACT_EMAIL=YOUR_LEGAL_CONTACT_EMAIL
LEGAL_ADDRESS=YOUR_LEGAL_ADDRESS
PRIVACY_CONTACT_EMAIL=YOUR_PRIVACY_CONTACT_EMAIL
SUPERVISORY_AUTHORITY=YOUR_SUPERVISORY_AUTHORITY

# Public base URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
